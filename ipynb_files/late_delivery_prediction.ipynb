    "import pandas as pd, glob, os\n",
    "\n",
    "dfs = {}\n",
    "for f in glob.glob(\"../data/*.csv\"):\n",
    "    name = os.path.basename(f).replace(\"olist_\", \"\").replace(\"_dataset.csv\", \"\").replace(\".csv\", \"\")\n",
    "    dfs[name] = pd.read_csv(f)\n",
    "\n",
    "print(list(dfs.keys()))"
